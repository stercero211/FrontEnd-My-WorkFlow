<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkFlow.CourseDetailPage"
             Title="Detalle del Curso"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="WorkflowBrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5C93F9" Offset="0.0" />
                <GradientStop Color="#5EEAD4" Offset="0.6" />
                <GradientStop Color="#86EFAC" Offset="1.0" />
            </LinearGradientBrush>

            <Shadow x:Key="FeedShadow" Brush="#000000" Opacity="0.08" Offset="0,2" Radius="8" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- BARRA SUPERIOR FIJA -->
        <Border Grid.Row="0"
                Padding="16,10"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <ImageButton Grid.Column="0"
                             Source="icon_arrow_back.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             Clicked="OnBackButtonClicked" />

                <Label Grid.Column="1"
                       Text="{Binding Course.Group}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                <ImageButton Grid.Column="2"
                             Source="icon_videocam.png"
                             WidthRequest="22"
                             HeightRequest="22"
                             BackgroundColor="Transparent"
                             Clicked="OnVideoCallClicked" />

                <ImageButton Grid.Column="3"
                             Source="icon_info.png"
                             WidthRequest="22"
                             HeightRequest="22"
                             BackgroundColor="Transparent"
                             Clicked="OnCourseInfoClicked" />
            </Grid>
        </Border>

        <!-- CONTENEDOR CENTRAL -->
        <Grid Grid.Row="1">

            <!-- VISTA 1: NOVEDADES -->
            <ScrollView x:Name="ViewNovedades" IsVisible="True">
                <VerticalStackLayout Spacing="16" Padding="16,12,16,24">

                    <!-- Banner de Portada -->
                    <Border HeightRequest="150"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Shadow="{StaticResource FeedShadow}">
                        <Grid>
                            <Image Source="{Binding Course.ImageUrl}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />

                            <Border StrokeThickness="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#30000000" Offset="0.0" />
                                        <GradientStop Color="#800F172A" Offset="0.5" />
                                        <GradientStop Color="#F00F172A" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid Padding="20" RowDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Row="1" Spacing="4">
                                        <Label Text="{Binding Course.Group}" 
                                               FontSize="26" 
                                               FontAttributes="Bold" 
                                               TextColor="White" />
                                        <Label Text="{Binding Course.Title}" 
                                               FontSize="15" 
                                               FontAttributes="Bold" 
                                               CharacterSpacing="0.5"
                                               TextColor="#5EEAD4" />
                                        <Label Text="{Binding Course.Teacher}"
                                               FontSize="12"
                                               TextColor="#CBD5E1" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Caja Anunciar -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,12"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                            Shadow="{StaticResource FeedShadow}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    StrokeShape="RoundRectangle 18"
                                    StrokeThickness="1.5"
                                    Stroke="#5EEAD4">
                                <Image Source="avatar_user.png" Aspect="AspectFill" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Anunciar algo a tu clase..."
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCreatePostTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <!-- Feed Novedades con Fondo Degradado según Categoría -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FeedPosts}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="16"
                                        Background="{Binding CardGradientBrush}"
                                        Shadow="{StaticResource FeedShadow}">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFeedPostTapped" />
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="10">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                                            <Border Grid.Column="0"
                                                    WidthRequest="42"
                                                    HeightRequest="42"
                                                    StrokeShape="RoundRectangle 21"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{Binding IconBgColor}">
                                                <Label Text="{Binding IconSymbol}"
                                                       FontSize="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                <Label Text="{Binding DateFormatted}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>

                                            <ImageButton Grid.Column="2"
                                                         Source="icon_more_vert.png"
                                                         WidthRequest="20"
                                                         HeightRequest="20"
                                                         BackgroundColor="Transparent"
                                                         Clicked="OnPostOptionsClicked" />
                                        </Grid>

                                        <HorizontalStackLayout Grid.Row="1" IsVisible="{Binding IsAssignment}">
                                            <Border Padding="8,4"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#382020}">
                                                <Label Text="{Binding DueDateText}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="#F87171" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                            <BoxView HeightRequest="1" 
                                                     Color="{AppThemeBinding Light=#F1F5F9, Dark=#272E38}" 
                                                     VerticalOptions="Center" />

                                            <Label Grid.Column="1"
                                                   Text="{Binding CommentsCountText}"
                                                   FontSize="12"
                                                   Margin="10,0,0,0"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- VISTA 2: TRABAJOS DE CLASE -->
            <ScrollView x:Name="ViewTrabajos" IsVisible="False">
                <VerticalStackLayout Spacing="20" Padding="16,16,16,24">

                    <Grid ColumnDefinitions="*, Auto" Padding="4,0">
                        <Label Grid.Column="0"
                               Text="Plan de Actividades"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                        <Button Grid.Column="1"
                                Text="Filtros"
                                FontSize="12"
                                TextColor="#5EEAD4"
                                BackgroundColor="Transparent"
                                Padding="8,0"
                                Clicked="OnFilterAssignmentsClicked" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AssignmentUnits}" Spacing="20">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*, Auto" Padding="4,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding UnitTitle}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#5EEAD4" />
                                        <Label Grid.Column="1"
                                               Text="{Binding ProgressSummary}"
                                               FontSize="12"
                                               TextColor="#5C93F9" />
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Assignments}" Spacing="10">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border StrokeThickness="1"
                                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                                        StrokeShape="RoundRectangle 14"
                                                        Padding="16,14"
                                                        Background="{Binding CardGradientBrush}"
                                                        Shadow="{StaticResource FeedShadow}">

                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnAssignmentTapped" />
                                                    </Border.GestureRecognizers>

                                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                                                        <Border Grid.Column="0"
                                                                WidthRequest="40"
                                                                HeightRequest="40"
                                                                StrokeShape="RoundRectangle 20"
                                                                StrokeThickness="0"
                                                                BackgroundColor="{Binding IconBackground}">
                                                            <Label Text="{Binding IconSymbol}"
                                                                   FontSize="18"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                            <Label Text="{Binding Title}"
                                                                   FontSize="14"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                            <Label Text="{Binding DueDateText}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                                        </VerticalStackLayout>

                                                        <Border Grid.Column="2"
                                                                Padding="10,4"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 8"
                                                                BackgroundColor="{Binding StatusBadgeBackground}"
                                                                VerticalOptions="Center">
                                                            <Label Text="{Binding StatusText}"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{Binding StatusTextColor}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- VISTA 3: PERSONAS -->
            <ScrollView x:Name="ViewPersonas" IsVisible="False">
                <VerticalStackLayout Spacing="24" Padding="16,16,16,24">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Profesores"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#5EEAD4"
                               Padding="4,0" />

                        <BoxView HeightRequest="1.5" Color="#5EEAD4" CornerRadius="1" Margin="4,0,4,4" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Teachers}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="14,12"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                                            Shadow="{StaticResource FeedShadow}">

                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                                            <Border Grid.Column="0"
                                                    WidthRequest="42"
                                                    HeightRequest="42"
                                                    StrokeShape="RoundRectangle 21"
                                                    Stroke="#5EEAD4"
                                                    StrokeThickness="1.5">
                                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding FullName}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                <Label Text="{Binding SubtitleRole}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>

                                            <ImageButton Grid.Column="2"
                                                         Source="icon_mail.png"
                                                         WidthRequest="22"
                                                         HeightRequest="22"
                                                         BackgroundColor="Transparent"
                                                         Clicked="OnEmailMemberClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto" Padding="4,0">
                            <Label Grid.Column="0"
                                   Text="Compañeros de clase"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />

                            <Label Grid.Column="1"
                                   Text="{Binding StudentsCountText}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#5C93F9"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#272E38}" Margin="4,0,4,4" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Students}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="14,10"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                                            Shadow="{StaticResource FeedShadow}">

                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                                            <Border Grid.Column="0"
                                                    WidthRequest="38"
                                                    HeightRequest="38"
                                                    StrokeShape="RoundRectangle 19"
                                                    StrokeThickness="1"
                                                    Stroke="#86EFAC">
                                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding FullName}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                <Label Text="{Binding SubtitleRole}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>

                                            <ImageButton Grid.Column="2"
                                                         Source="icon_mail.png"
                                                         WidthRequest="20"
                                                         HeightRequest="20"
                                                         BackgroundColor="Transparent"
                                                         Clicked="OnEmailMemberClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- BARRA DE NAVEGACIÓN INFERIOR -->
        <Border Grid.Row="2"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#272E38}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                Padding="0,6,0,10">
            <Grid ColumnDefinitions="*, *, *">

                <!-- Pestaña 1: Novedades -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Label Text="📢" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabNovedadesLabel"
                           Text="Novedades" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="#5EEAD4" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabNovedadesIndicator"
                             HeightRequest="3" 
                             WidthRequest="28" 
                             Color="#5EEAD4" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabNovedadesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Pestaña 2: Trabajos -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label Text="📋" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabTrabajosLabel"
                           Text="Trabajos" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabTrabajosIndicator"
                             HeightRequest="3" 
                             WidthRequest="28" 
                             Color="Transparent" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTrabajosTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Pestaña 3: Personas -->
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Label Text="👥" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabPersonasLabel"
                           Text="Personas" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabPersonasIndicator"
                             HeightRequest="3" 
                             WidthRequest="28" 
                             Color="Transparent" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabPersonasTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>