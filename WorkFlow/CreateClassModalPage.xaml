<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkFlow.CreateClassModalPage"
             Title="Crear clase"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Degradado insignia WorkFlow -->
            <LinearGradientBrush x:Key="WorkflowBrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5C93F9" Offset="0.0" />
                <GradientStop Color="#5EEAD4" Offset="0.6" />
                <GradientStop Color="#86EFAC" Offset="1.0" />
            </LinearGradientBrush>

            <Shadow x:Key="FormCardShadow" Brush="#000000" Opacity="0.08" Offset="0,3" Radius="8" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Estructura Raíz -->
    <Grid RowDefinitions="Auto, *">

        <!-- ============================================================== -->
        <!-- 1. BARRA SUPERIOR DE ACCIONES (CANCELAR / CREAR)               -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="16,12"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.05" Offset="0,2" Radius="4" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <!-- Botón Cancelar / Cerrar -->
                <ImageButton Grid.Column="0"
                             Source="icon_close.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             Clicked="OnCancelClicked" />

                <!-- Título Central -->
                <Label Grid.Column="1"
                       Text="Crear una clase"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="14,0,0,0"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                <!-- Botón Principal "Crear" -->
                <Border Grid.Column="2"
                        x:Name="CreateButtonBorder"
                        HeightRequest="36"
                        Padding="18,0"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        Background="{StaticResource WorkflowBrandBrush}"
                        Opacity="0.5">
                    <Grid>
                        <Label Text="Crear"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Button x:Name="CreateButton"
                                BackgroundColor="Transparent"
                                IsEnabled="False"
                                Clicked="OnCreateClassClicked" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. FORMULARIO PRINCIPAL                                        -->
        <!-- ============================================================== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16" Spacing="16">

                <!-- TARJETA 1: VISTA PREVIA DINÁMICA DE LA PORTADA -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Vista previa de la tarjeta"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />

                    <Border HeightRequest="130"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 16"
                            Shadow="{StaticResource FormCardShadow}">
                        <Grid>
                            <!-- Imagen de fondo actual -->
                            <Image x:Name="PreviewCoverImage" Source="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                   Aspect="AspectFill" />

                            <!-- Overlay con degradado para lectura -->
                            <Border StrokeThickness="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#30000000" Offset="0.0" />
                                        <GradientStop Color="#900F172A" Offset="0.6" />
                                        <GradientStop Color="#F00F172A" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid Padding="16" RowDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Row="0" Spacing="2">
                                        <Label x:Name="PreviewGroupLabel"
                                               Text="5IM6" 
                                               FontSize="18" 
                                               FontAttributes="Bold" 
                                               TextColor="White" />
                                        <Label x:Name="PreviewTitleLabel"
                                               Text="Nombre de la clase..." 
                                               FontSize="13" 
                                               FontAttributes="Bold" 
                                               TextColor="#5EEAD4"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Label x:Name="PreviewDetailsLabel"
                                           Grid.Row="1"
                                           Text="Aula / Especialidad"
                                           FontSize="11"
                                           TextColor="#E2E8F0" />
                                </Grid>
                            </Border>

                            <!-- Botón sobre la portada para seleccionar foto -->
                            <Button Text="📷 Cambiar portada"
                                    FontSize="11"
                                    TextColor="White"
                                    BackgroundColor="#70000000"
                                    CornerRadius="14"
                                    HeightRequest="32"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="10"
                                    Padding="10,0"
                                    Clicked="OnPickCoverImageClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- TARJETA 2: CAMPOS DEL FORMULARIO -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                        StrokeShape="RoundRectangle 14"
                        Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                        Shadow="{StaticResource FormCardShadow}">

                    <VerticalStackLayout Spacing="14">

                        <!-- Campo 1: Nombre de la clase (Obligatorio) -->
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="Nombre de la clase"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                <Label Text="*" TextColor="#EF4444" FontSize="13" />
                            </HorizontalStackLayout>
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}"
                                    Padding="12,2">
                                <Entry x:Name="ClassNameEntry"
                                       Placeholder="Ej. Modelado de Sistemas"
                                       PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       FontSize="14"
                                       TextChanged="OnFormFieldsChanged" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Campo 2: Grupo o Sección -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Grupo / Sección"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}"
                                    Padding="12,2">
                                <Entry x:Name="GroupEntry"
                                       Placeholder="Ej. 5IM6"
                                       PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       FontSize="14"
                                       TextChanged="OnFormFieldsChanged" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Campo 3: Especialidad o Carrera -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Especialidad / Área"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}"
                                    Padding="12,2">
                                <Entry x:Name="SubjectEntry"
                                       Placeholder="Ej. Técnico en Informática"
                                       PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       FontSize="14"
                                       TextChanged="OnFormFieldsChanged" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Campo 4: Aula o Laboratorio -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Aula / Laboratorio (Opcional)"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}"
                                    Padding="12,2">
                                <Entry x:Name="RoomEntry"
                                       Placeholder="Ej. Laboratorio 3 de Cómputo"
                                       PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       FontSize="14"
                                       TextChanged="OnFormFieldsChanged" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Indicador de carga durante la creación -->
                <ActivityIndicator x:Name="CreationSpinner"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#5EEAD4"
                                   HorizontalOptions="Center"
                                   Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>