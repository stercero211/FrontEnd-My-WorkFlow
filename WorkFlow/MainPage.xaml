<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkFlow.MainPage"
             Title="WorkFlow"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="WorkflowBrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5C93F9" Offset="0.0" />
                <GradientStop Color="#5EEAD4" Offset="0.6" />
                <GradientStop Color="#86EFAC" Offset="1.0" />
            </LinearGradientBrush>

            <Shadow x:Key="CardShadow" Brush="#000000" Opacity="0.12" Offset="0,4" Radius="10" />
            <Shadow x:Key="FabShadow" Brush="#5EEAD4" Opacity="0.4" Offset="0,6" Radius="14" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- BARRA SUPERIOR -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="20,12"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.06" Offset="0,2" Radius="6" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="14" VerticalOptions="Center">
                <ImageButton Grid.Column="0"
                             Source="icon_menu.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent" />

                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="Work" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                    <Label Text="Flow" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#5EEAD4" />
                </HorizontalStackLayout>

                <ImageButton Grid.Column="2"
                             Source="icon_add.png"
                             WidthRequest="22"
                             HeightRequest="22"
                             BackgroundColor="Transparent"
                             Clicked="OnAddClassClicked" />

                <Border Grid.Column="3"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeShape="RoundRectangle 19"
                        StrokeThickness="1.5"
                        Stroke="#86EFAC">
                    <Image Source="avatar_user.png" Aspect="AspectFill" />
                </Border>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24" Padding="0,16,0,100">

                <!-- MIS CLASES INSCRITAS -->
                <VerticalStackLayout Spacing="12">
                    <Grid Padding="20,0" ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Mis Clases Inscritas"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />

                        <Label Grid.Column="1"
                               Text="Ver todas"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#5C93F9"
                               VerticalOptions="Center" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding EnrolledCourses}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnCourseSelected"
                                    HeightRequest="150"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="14" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.Header>
                            <BoxView WidthRequest="14" Color="Transparent" />
                        </CollectionView.Header>
                        <CollectionView.Footer>
                            <BoxView WidthRequest="14" Color="Transparent" />
                        </CollectionView.Footer>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="240"
                                        HeightRequest="140"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                        StrokeShape="RoundRectangle 18"
                                        Shadow="{StaticResource CardShadow}">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill" />

                                        <Border StrokeThickness="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#30000000" Offset="0.0" />
                                                    <GradientStop Color="#850F172A" Offset="0.5" />
                                                    <GradientStop Color="#F00F172A" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <Grid Padding="16" RowDefinitions="*, Auto">
                                                <VerticalStackLayout Grid.Row="0" Spacing="2">
                                                    <Label Text="{Binding Group}" 
                                                           FontSize="18" 
                                                           FontAttributes="Bold" 
                                                           TextColor="White" />
                                                    <Label Text="{Binding Title}" 
                                                           FontSize="12" 
                                                           FontAttributes="Bold" 
                                                           TextColor="#5EEAD4"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>

                                                <Label Grid.Row="1"
                                                       Text="{Binding Teacher}"
                                                       FontSize="11"
                                                       TextColor="#E2E8F0"
                                                       LineBreakMode="TailTruncation" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- TABLÓN DE NOVEDADES GLOBAL -->
                <VerticalStackLayout Spacing="12" Padding="20,0">
                    <Label Text="Tablón de Novedades"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentPosts}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="16"
                                        Background="{Binding CardGradientBrush}"
                                        Shadow="{StaticResource CardShadow}">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRecentPostTapped" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" RowDefinitions="Auto, Auto">
                                        <Border Grid.Row="0" Grid.Column="0"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                StrokeShape="RoundRectangle 20"
                                                StrokeThickness="0"
                                                BackgroundColor="#162D34">
                                            <Label Text="{Binding Icon}" 
                                                   FontSize="18" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />
                                            <Label Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" 
                                                               Margin="0,8,0,0" 
                                                               IsVisible="{Binding HasDueDate}">
                                            <Border Padding="8,3"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#382020}">
                                                <Label Text="{Binding DueText}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="#F87171" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTÓN FLOTANTE (FAB) -->
        <Border Grid.Row="1"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,22,24"
                WidthRequest="60"
                HeightRequest="60"
                StrokeShape="RoundRectangle 30"
                StrokeThickness="0"
                Background="{StaticResource WorkflowBrandBrush}"
                Shadow="{StaticResource FabShadow}">
            <Grid>
                <Label Text="+"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,-2,0,0" />

                <Button BackgroundColor="Transparent"
                        Clicked="OnAddClassClicked" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>