<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkFlow.TaskDetailPage"
             Title="Detalle de la Tarea"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Degradado insignia WorkFlow -->
            <LinearGradientBrush x:Key="WorkflowBrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5C93F9" Offset="0.0" />
                <GradientStop Color="#5EEAD4" Offset="0.6" />
                <GradientStop Color="#86EFAC" Offset="1.0" />
            </LinearGradientBrush>

            <Shadow x:Key="CardShadow" Brush="#000000" Opacity="0.08" Offset="0,2" Radius="8" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- ============================================================== -->
        <!-- 0. BARRA SUPERIOR DE ACCIONES                                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Padding="16,10"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <ImageButton Grid.Column="0"
                             Source="icon_arrow_back.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             Clicked="OnBackButtonClicked" />

                <Label Grid.Column="1"
                       Text="Tarea"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                <ImageButton Grid.Column="2"
                             Source="icon_more_vert.png"
                             WidthRequest="22"
                             HeightRequest="22"
                             BackgroundColor="Transparent"
                             Clicked="OnMoreOptionsClicked" />
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 1. CONTENIDO PRINCIPAL CON SCROLL                              -->
        <!-- ============================================================== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="16,16,16,30">

                <!-- TARJETA: ENCABEZADO E INSTRUCCIONES DE LA TAREA -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                        StrokeShape="RoundRectangle 16"
                        Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                        Shadow="{StaticResource CardShadow}">

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Start">
                            <Label Grid.Column="0"
                                   Text="{Binding Assignment.Title}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                            <Border Grid.Column="1"
                                    Padding="10,4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{Binding Assignment.StatusBadgeBackground}">
                                <Label Text="{Binding Assignment.StatusText}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{Binding Assignment.StatusTextColor}" />
                            </Border>
                        </Grid>

                        <HorizontalStackLayout Spacing="12">
                            <Label Text="{Binding Assignment.DueDateText}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#F87171" />
                            <Label Text="•" TextColor="#64748B" FontSize="12" />
                            <Label Text="100 puntos"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#272E38}" Margin="0,4" />

                        <Label Text="Instrucciones:"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />

                        <Label Text="{Binding InstructionsText}"
                               FontSize="13"
                               LineHeight="1.3"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
                    </VerticalStackLayout>
                </Border>

                <!-- MATERIALES ADJUNTOS POR EL DOCENTE -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Materiales de referencia"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="📄" FontSize="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Guia_Actividad_1_DerechoMercantil.pdf"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="Documento PDF • 1.2 MB"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="Ver"
                                    FontSize="12"
                                    TextColor="#5C93F9"
                                    BackgroundColor="Transparent"
                                    Clicked="OnOpenTeacherAttachmentClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- TARJETA: TU TRABAJO (ADJUNTAR Y ENTREGAR) -->
                <Border StrokeThickness="1.5"
                        Stroke="#5EEAD4"
                        StrokeShape="RoundRectangle 18"
                        Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                        Shadow="{StaticResource CardShadow}">

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="Tu trabajo"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                            <Label Grid.Column="1"
                                   Text="{Binding SubmissionStatusLabel}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#86EFAC"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- LISTA DE ARCHIVOS CARGADOS POR EL ALUMNO -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding StudentAttachments}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="10,8"
                                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="{Binding FileIcon}" FontSize="18" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding FileName}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding FileSizeText}"
                                                       FontSize="10"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>
                                            <ImageButton Grid.Column="2"
                                                         Source="icon_close.png"
                                                         WidthRequest="18"
                                                         HeightRequest="18"
                                                         BackgroundColor="Transparent"
                                                         Clicked="OnRemoveAttachmentClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- BOTÓN: SELECCIONAR O AGREGAR ARCHIVO -->
                        <Border StrokeThickness="1"
                                Stroke="#5C93F9"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="Transparent"
                                HeightRequest="40">
                            <Grid>
                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                    <Label Text="+" FontSize="18" FontAttributes="Bold" TextColor="#5C93F9" />
                                    <Label Text="Agregar trabajo o archivo" FontSize="13" FontAttributes="Bold" TextColor="#5C93F9" />
                                </HorizontalStackLayout>
                                <Button BackgroundColor="Transparent" Clicked="OnAddAttachmentClicked" />
                            </Grid>
                        </Border>

                        <!-- BOTÓN PRINCIPAL: ENTREGAR / ANULAR ENTREGA -->
                        <Border x:Name="SubmitButtonBorder"
                                HeightRequest="44"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                Background="{StaticResource WorkflowBrandBrush}">
                            <Grid>
                                <Label x:Name="SubmitButtonTextLabel"
                                       Text="Entregar tarea"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Button x:Name="SubmitButton"
                                        BackgroundColor="Transparent"
                                        Clicked="OnSubmitWorkClicked" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- TARJETA: COMENTARIOS PRIVADOS CON EL PROFESOR -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                        StrokeShape="RoundRectangle 14"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Comentarios privados"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                        <!-- Mensajes enviados -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PrivateComments}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding AuthorName}" FontSize="11" FontAttributes="Bold" TextColor="#5EEAD4" />
                                            <Label Text="{Binding TimeAgo}" FontSize="10" TextColor="#64748B" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Message}" FontSize="12" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Caja de entrada para comentario -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,4,0,0">
                            <Border Grid.Column="0"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}"
                                    Padding="10,0">
                                <Entry x:Name="PrivateCommentEntry"
                                       Placeholder="Añadir comentario para el profesor..."
                                       PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       FontSize="12" />
                            </Border>

                            <Button Grid.Column="1"
                                    Text="Enviar"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#0F172A"
                                    BackgroundColor="#5EEAD4"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    Clicked="OnSendCommentClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                
                <ActivityIndicator x:Name="WorkSpinner"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#5EEAD4"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>